# Base URL de la app. Local: /. GitHub Pages proyecto: /<repo>/
BASEURL=/
# Storyblok: Settings > Access Tokens > Public token
ACCESSTOKEN=
# Región del space Storyblok en minúsculas: eu (default), us o cn
REGION=eu
# Contacto (nuxt-mail, solo dev con servidor; en estático no hay /api)
SMPT_MESSAGE_TO=
SMPT_HOST=
SMPT_PORT=587
SMPT_PASSWORD=
# URL pública del Worker de contacto (Cloudflare). Vacío = formulario con error.
# La RESEND_API_KEY vive SOLO como secreto del Worker, nunca aquí.
CONTACT_API_URL=
