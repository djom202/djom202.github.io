# Base URL de la app. Local: /. GitHub Pages proyecto: /<repo>/
BASEURL=/
# Storyblok: Settings > Access Tokens > Public token
ACCESSTOKEN=
# Región del space Storyblok en minúsculas: eu (default), us o cn
REGION=eu
# Contact form posts to a Cloudflare Worker (see workers/contact.js).
# Empty locally = simulated send. Production URL via Actions variables.
# No SMTP needed (nuxt-mail removed); the Resend key lives only as a
# Worker secret, never here.
CONTACT_API_URL=
